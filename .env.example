# ──────────────────────────────────────────────────────────────
# LessonForge environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL (pgvector) ─────────────────────────────────────
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=lessonforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async driver URL used by the API/worker (SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://forge:forge@postgres:5432/lessonforge

# ── Redis (cache / queue / event streams) ─────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO, S3-compatible) ─────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lesson-forge
S3_REGION=us-east-1

# ── Auth / security ───────────────────────────────────────────
# CHANGE THIS in any non-local environment.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:3000

# ── LLM providers (optional until agents are implemented) ─────
# Agents are stubbed in this foundation; keys are read but unused.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_DIM=1536

# ── Web (Next.js) ─────────────────────────────────────────────
# Browser-visible; must be reachable from the host, not the compose network.
NEXT_PUBLIC_API_URL=http://localhost:8000
