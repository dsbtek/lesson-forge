# ──────────────────────────────────────────────────────────────
# LessonForge environment configuration
# Copy this file to `.env` and adjust as needed:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL (pgvector) ─────────────────────────────────────
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge
POSTGRES_DB=lessonforge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Async driver URL used by the API/worker (SQLAlchemy + asyncpg).
DATABASE_URL=postgresql+asyncpg://forge:forge@postgres:5432/lessonforge

# ── Redis (cache / queue / event streams) ─────────────────────
REDIS_URL=redis://redis:6379/0

# ── Object storage (MinIO, S3-compatible) ─────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lesson-forge
S3_REGION=us-east-1

# ── Auth / security ───────────────────────────────────────────
# CHANGE THIS in any non-local environment.
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ───────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins for the API.
CORS_ORIGINS=http://localhost:3000

# ── LLM (local llama.cpp router or Ollama) ────────────────────
# See docs/model-integration.md for the local llama.cpp multi-model & agent API.
# While LLM_ENABLED=false, agents produce deterministic fallback output (no
# model required) — the app still boots and runs.
LLM_ENABLED=false
# Provider: "openai_compat" (llama-api-router / OpenAI-compatible) or "ollama".
LLM_PROVIDER=openai_compat
# From inside compose containers, reach a host-run router via host.docker.internal
# (api/worker map it to host-gateway for Linux). If attached to the external
# `ai-models_default` network, use http://llama-api-router:8080/v1 instead.
# Use http://localhost:8080/v1 when running the API outside Docker.
AI_BASE_URL=http://host.docker.internal:8080/v1
AI_API_KEY=not-needed
# Base models: qwen2.5-1.5b (reasoning/structured output), llama-3.2-1b (fast text)
# Virtual agents: json-extractor, coder, summarizer, classifier, general-assistant
LLM_MODEL=qwen2.5-1.5b
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120
# Legacy Ollama settings (used only when LLM_PROVIDER=ollama):
OLLAMA_HOST=http://host.docker.internal:11434

# ── Reflection / repair loop ──────────────────────────────────
# A failed validation or a critic score below QUALITY_THRESHOLD routes the
# graph back to the designer, up to MAX_REVISIONS times.
QUALITY_THRESHOLD=0.8
MAX_REVISIONS=2

# ── Other LLM providers (reserved for later phases) ───────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Hybrid RAG (Phase 3, README §10) ──────────────────────────
# The Curriculum Researcher grounds standards in ingested curriculum docs via
# hybrid dense+sparse retrieval. Disabled by default: with RAG_ENABLED=false no
# DB/embedding calls happen and the researcher uses deterministic fallbacks.
# To enable, ensure the embedding model is available (all-minilm-l6-v2 on
# llama-api-router, or nomic-embed-text on Ollama), set RAG_ENABLED=true, apply
# migrations (make migrate), and ingest docs (make ingest). EMBEDDING_DIM must
# match the model (all-minilm-l6-v2 = 384, nomic-embed-text = 768); changing it
# requires re-running migrations against an empty embedding column.
RAG_ENABLED=false
EMBEDDING_MODEL=all-minilm-l6-v2
EMBEDDING_DIM=384
# Number of evidence chunks fed to the researcher per generation.
RAG_TOP_K=8

# ── Web (Next.js) ─────────────────────────────────────────────
# Browser-visible; must be reachable from the host, not the compose network.
NEXT_PUBLIC_API_URL=http://localhost:8000
